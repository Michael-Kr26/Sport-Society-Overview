{
  "name": "sport-society-overview",
  "version": "1.5.0-alpha.2",
  "description": "Operationeel administratie- en analyseplatform voor Sport Society",
  "main": "app.js",
  "scripts": {
    "test": "npm run test:syntax && npm run test:contracts && npm run test:employeeui && npm run test:ui && npm run test:masterdata && npm run test:rosterdata && npm run test:rosterdomain && npm run test:legacyadapter && npm run test:rosterplanner && npm run test:rosterpublication && npm run test:rosteraccess && npm run test:rosteroperations && npm run test:rosterexport && npm run test:rosterpages && npm run test:restore",
    "test:syntax": "node scripts/check-javascript.js",
    "test:contracts": "node --test tests/legacy-contracts.test.js",
    "test:employeeui": "node --test tests/employee-ui-v2.test.js",
    "test:ui": "node --test tests/ui-design-system.test.js",
    "test:masterdata": "node --test tests/masterdata.test.js tests/masterdata-r1b.test.js",
    "test:rosterdata": "node --test tests/roster-data.test.js",
    "test:rosterdomain": "node --test tests/roster-domain.test.js",
    "test:legacyadapter": "node --test tests/legacy-roster-adapter.test.js",
    "test:rosterplanner": "node --test tests/roster-planner.test.js tests/r5-transition-protection.test.js",
    "test:rosterpublication": "node --test tests/roster-publication.test.js",
    "test:rosteraccess": "node --test tests/roster-access.test.js",
    "test:rosteroperations": "node --test tests/roster-operations.test.js tests/r8-ui-contracts.test.js",
    "test:rosterexport": "node --test tests/roster-export.test.js",
    "test:rosterpages": "node --test tests/roster-page-split.test.js",
    "test:restore": "node --test tests/database-restore.test.js",
    "start": "node migrate-masterdata.js --quiet && node migrate-roster-export.js --quiet && node migrate-employee-names.js --quiet && node migrate-hours.js && node start-server.js",
    "migrate:masterdata": "node migrate-masterdata.js",
    "migrate:rosterdata": "node migrate-roster-v2.js",
    "migrate:rosterdomain": "node migrate-roster-domain.js",
    "migrate:rosterpublication": "node migrate-roster-publication.js",
    "migrate:rosteroperations": "node migrate-roster-operations.js",
    "migrate:rosterexport": "node migrate-roster-export.js",
    "report:masterdata": "node scripts/report-masterdata.js",
    "report:rosterdata": "node scripts/report-roster-data.js",
    "report:roster-parity": "node scripts/report-legacy-roster-parity.js",
    "report:roster-operations-parity": "node scripts/report-roster-operations-parity.js",
    "import:roster": "node import-roster-linked.js",
    "import:canonical-roster": "node import-roster-canonical.js",
    "refresh:roster": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-roster.ps1",
    "report:hour-sources": "node report-hour-sources.js",
    "report:hour-snapshot": "node scripts/report-hour-snapshot.js",
    "import:visitors": "node import-visitor-frequency.js",
    "preview:healthplanner": "node import-healthplanner.js",
    "import:healthplanner": "node import-healthplanner.js --commit",
    "backup:db": "node scripts/backup-database.js",
    "verify:backup": "node scripts/verify-database-backup.js",
    "restore:db": "node scripts/restore-database.js",
    "download:roster": "node download-roster.js",
    "sync:roster": "node download-roster.js && node import-roster-linked.js data/imports/live-rooster.xlsx"
  },
  "repository": { "type": "git", "url": "git+https://github.com/Michael-Kr26/Sport-Society-Overview.git" },
  "keywords": ["workforce-management", "operations", "administration", "analytics"],
  "author": "Krijnen M&B",
  "license": "ISC",
  "type": "commonjs",
  "bugs": { "url": "https://github.com/Michael-Kr26/Sport-Society-Overview/issues" },
  "homepage": "https://github.com/Michael-Kr26/Sport-Society-Overview#readme",
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^3.4.0",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": { "sqlite3@6.0.1": true }
}